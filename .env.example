# ---------------------------------------------------------------------------
# hmrc-rti-service - local environment template. Copy to .env; never commit .env.
# .NET uses double underscores for nested configuration keys.
# ---------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
RTI_PORT=8081

# Shared payroll database. Also accepts a postgresql:// URL.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=payroll;Username=payroll;Password=payroll_dev_pwd

# MUST match the payroll API's APP_SECRET_KEY, or its tokens will not validate here.
PlatformAuth__SecretKey=change-me-in-production-this-must-be-at-least-32-chars
PayrollApi__BaseUrl=http://localhost:8000

# HMRC (placeholders - real credentials come from the vault).
# Leave blank to run against the built-in simulator.
Hmrc__BaseUrl=https://test-api.service.hmrc.gov.uk
Hmrc__ClientId=
Hmrc__ClientSecret=
# SOW gating rule 3: live filing also requires ASPNETCORE_ENVIRONMENT=Production.
Hmrc__AllowLiveSubmission=false
